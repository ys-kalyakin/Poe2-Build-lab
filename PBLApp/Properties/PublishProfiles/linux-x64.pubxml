<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained Linux x64 single-file publish.

  Usage:
    dotnet publish PBLApp/PBLApp.csproj -p:PublishProfile=linux-x64 -o publish/linux-x64

  Output:
    publish/linux-x64/PBLApp              — single-file self-contained app (no .NET install needed)
    publish/linux-x64/liblua54.so         — native Lua 5.4 (kept next to the binary:
    publish/linux-x64/libSkiaSharp.so       self-extract to /tmp is slower and not needed)
    publish/linux-x64/libHarfBuzzSharp.so
    publish/linux-x64/Assets/TreeData/    — tree sprite sheets (copied as Content)
    publish/linux-x64/src/                — Lua engine sources (CopyEngineFiles target)
    publish/linux-x64/runtime/lua/, lua/  — Lua compat shims
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net9.0</TargetFramework>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <!-- ReadyToRun adds ~30 MB; skip for smaller distribution. Re-enable if startup is slow. -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- Trimming requires DynamicallyAccessedMembers annotations all over NLua / Avalonia bindings;
         leaving it off keeps the build reliable. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
